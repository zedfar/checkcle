# CheckCle Self-Build Stack - Environment Configuration
# Copy file ini ke .env.build lalu jalankan:
#   docker compose -f docker-compose.build.yml --env-file .env.build up -d --build

# ============================================================
# PORT CONFIGURATION
# ============================================================
FRONTEND_PORT=18080
PB_PORT=18090

# ============================================================
# POCKETBASE - DEFAULT ADMIN
# Dibuat otomatis saat fresh deployment (volume baru).
# Credential ini juga digunakan oleh service-operation untuk
# mengakses PocketBase API. Ganti sebelum deploy ke production.
# ============================================================
PB_ADMIN_EMAIL=admin@checkcle.local
PB_ADMIN_PASSWORD=Admin@12345
PB_ADMIN_FULL_NAME=Administrator
PB_ADMIN_USERNAME=admin

# ============================================================
# POCKETBASE - SECURITY (opsional)
# ============================================================
# Encryption key 32 karakter untuk enkripsi settings
# Generate: openssl rand -base64 32 | head -c 32
# PB_ENCRYPTION_KEY=your-32-character-secret-key-here

# ============================================================
# DEBUG
# ============================================================
ENABLE_LOGGING=true
